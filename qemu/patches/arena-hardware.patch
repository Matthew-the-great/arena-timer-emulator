diff --git a/hw/misc/esp32_phya.c b/hw/misc/esp32_phya.c
new file mode 100644
index 0000000..d52b11c
--- /dev/null
+++ b/hw/misc/esp32_phya.c
@@ -0,0 +1,131 @@
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/guest-random.h"
+#include "qapi/error.h"
+#include "hw/hw.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_phya.h"
+#include "hw/qdev-properties.h"
+
+#define DEBUG(x)
+
+/* Inferred from the unchanged ESP32 PHY driver, not a silicon specification.
+ * FE 0x7c: enable bit 0, start bit 1, count bits 2..16, done bit 31.
+ * This opt-in model captures an ideal zero-input signal. The assumed sample
+ * period is 1 us; RF gain, noise and calibration accuracy are NOT modeled. */
+static void esp32_capture_done(void *opaque)
+{
+    Esp32PhyaState *s = opaque;
+    if ((s->mem[0x7c / 4] & 3) == 3) {
+        s->mem[0xdc / 4] = 0;
+        s->mem[0xe0 / 4] = 0;
+        s->mem[0xe4 / 4] = 0;
+        s->mem[0x7c / 4] |= BIT(31);
+    }
+}
+
+static uint64_t esp32_phya_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    uint32_t r = 0;
+    Esp32PhyaState *s = ESP32_PHYA(opaque);
+    r=s->mem[addr/4];
+    /*
+    if(addr == 0x270){ //failed ACK
+       r = 0x00002300;
+    }
+    */
+    DEBUG( printf("esp32_phya_read  0x%04lx= 0x%08x\n",addr,r);)
+
+    return r;
+}
+
+static void esp32_phya_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned int size) {
+  Esp32PhyaState *s = ESP32_PHYA(opaque);
+
+  DEBUG( printf("esp32_phya_write 0x%04lx= 0x%08lx\n",addr, value);)
+
+  if (s->experimental_capture && addr == 0x7c) {
+      uint32_t old = s->mem[addr / 4];
+      uint32_t next = (value & ~BIT(31)) | (old & BIT(31));
+      if ((next & 3) != 3) {
+          timer_del(s->capture_timer);
+          next &= ~BIT(31);
+      } else if ((old & 3) != 3) {
+          next &= ~BIT(31);
+          unsigned count = ((next >> 2) & 0x7fff) + 1;
+          timer_mod(s->capture_timer,
+                    qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + count * 1000ULL);
+      }
+      s->mem[addr / 4] = next;
+  } else {
+      s->mem[addr/4]=(uint32_t)value;
+  }
+}
+
+static const MemoryRegionOps esp32_phya_ops = {
+    .read =  esp32_phya_read,
+    .write = esp32_phya_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4,
+               .unaligned = false },
+};
+
+static void esp32_phya_reset(DeviceState *dev)
+{
+    Esp32PhyaState *s = ESP32_PHYA(dev);
+    timer_del(s->capture_timer);
+    memset(s->mem, 0, sizeof(s->mem));
+}
+
+static Property esp32_phya_properties[] = {
+    DEFINE_PROP_BOOL("experimental-capture", Esp32PhyaState, experimental_capture, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32_phya_class_init(ObjectClass *klass, void *data)
+{
+    device_class_set_legacy_reset(DEVICE_CLASS(klass), esp32_phya_reset);
+    device_class_set_props(DEVICE_CLASS(klass), esp32_phya_properties);
+}
+
+static void esp32_phya_init(Object *obj)
+{
+    Esp32PhyaState *s = ESP32_PHYA(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32_phya_ops, s,
+                          TYPE_ESP32_PHYA, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    memset(s->mem,0,sizeof(s->mem));
+    s->capture_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, esp32_capture_done, s);
+}
+
+static void esp32_phya_finalize(Object *obj)
+{
+    Esp32PhyaState *s = ESP32_PHYA(obj);
+    timer_free(s->capture_timer);
+}
+
+
+static const TypeInfo esp32_phya_info = {
+    .name = TYPE_ESP32_PHYA,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32PhyaState),
+    .instance_init = esp32_phya_init,
+    .class_init = esp32_phya_class_init,
+    .instance_finalize = esp32_phya_finalize,
+};
+
+static void esp32_phya_register_types(void)
+{
+    type_register_static(&esp32_phya_info);
+    static const TypeInfo fe_info = {
+        .name = "esp32.fe",
+        .parent = TYPE_ESP32_PHYA,
+    };
+    type_register_static(&fe_info);
+}
+
+type_init(esp32_phya_register_types)
diff --git a/hw/misc/esp32_rmt.c b/hw/misc/esp32_rmt.c
new file mode 100644
index 0000000..1867056
--- /dev/null
+++ b/hw/misc/esp32_rmt.c
@@ -0,0 +1,228 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Experimental ESP32 RMT transmit model. Register layout follows ESP-IDF
+ * soc/esp32/register/soc/rmt_struct.h. RX/carrier and migration unsupported.
+ * Telemetry exports raw hardware symbols, never fabricated timer state.
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/misc/esp32_rmt.h"
+
+#define RAW (0xa0 / 4)
+#define ENA (0xa8 / 4)
+static void update_irq(ArenaRmtState *s)
+{
+    qemu_set_irq(s->irq, !!(s->regs[RAW] & s->regs[ENA]));
+}
+static void emit(ArenaRmtChannel *c, const char *event, uint32_t word)
+{
+    if (!c->parent->trace_symbols) { return; }
+    char line[128];
+    int n = snprintf(line, sizeof(line),
+        "{\"event\":\"%s\",\"channel\":%u,\"word\":%u,\"ns\":%" PRId64 "}\n",
+        event, c->index, word, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    if (qemu_chr_fe_backend_connected(&c->parent->telemetry)) {
+        qemu_chr_fe_write_all(&c->parent->telemetry, (uint8_t *)line, n);
+    }
+}
+static void emit_pixels(ArenaRmtChannel *c)
+{
+    ArenaRmtState *s = c->parent;
+    if (!s->gpio || c->invalid || c->bits < 24 ||
+        !qemu_chr_fe_backend_connected(&s->telemetry)) { return; }
+    char rgb[sizeof(c->pixels) * 2 + 1];
+    /* Complete pixels latch even if the final pixel is incomplete. */
+    unsigned bytes = (c->bits / 24) * 3;
+    for (unsigned i = 0; i < bytes; i += 3) {
+        snprintf(rgb + i * 2, 7, "%02x%02x%02x",
+                 c->pixels[i + 1], c->pixels[i], c->pixels[i + 2]);
+    }
+    for (unsigned pin = 0; pin < 40; pin++) {
+        uint32_t route = s->gpio->regs[0x530 / 4 + pin];
+        if ((route & 0x1ff) != 87 + c->index || (route & (1 << 9))) { continue; }
+        char line[sizeof(rgb) + 160];
+        int n = snprintf(line, sizeof(line),
+            "{\"event\":\"leds\",\"pin\":%u,\"channel\":%u,\"pixels\":\"%s\",\"ns\":%" PRId64 ",\"bits\":%u}\n",
+            pin, c->index, rgb, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), c->bits);
+        qemu_chr_fe_write_all(&s->telemetry, (uint8_t *)line, n);
+    }
+}
+static void decode_pixel(ArenaRmtChannel *c, uint32_t word)
+{
+    unsigned high = word & 0x7fff, low = (word >> 16) & 0x7fff;
+    unsigned conf = 8 + c->index * 2;
+    unsigned divider = c->parent->regs[conf] & 255;
+    if (!divider) { divider = 256; }
+    uint64_t hz = c->parent->regs[conf + 1] & (1u << 17) ? 80000000 : 1000000;
+    uint64_t high_ns = (uint64_t)high * divider * 1000000000 / hz;
+    uint64_t low_ns = (uint64_t)low * divider * 1000000000 / hz;
+    if (!(word & 0x80008000) && high_ns + low_ns >= 50000) {
+        emit_pixels(c); c->bits = 0; c->invalid = false;
+        memset(c->pixels, 0, sizeof(c->pixels)); return;
+    }
+    if (high_ns < 150 || high_ns > 1000 || low_ns < 150 || low_ns > 1500) {
+        c->invalid = true; return;
+    }
+    if (!(word & 0x8000) || (word & 0x80000000) || !low ||
+        c->bits >= sizeof(c->pixels) * 8) { c->invalid = true; return; }
+    c->pixels[c->bits / 8] |= (high > low) << (7 - c->bits % 8);
+    c->bits++;
+}
+static void step(void *opaque)
+{
+    ArenaRmtChannel *c = opaque;
+    ArenaRmtState *s = c->parent;
+    unsigned ch = c->index, conf = 8 + ch * 2;
+    unsigned blocks = (s->regs[conf] >> 24) & 15;
+    unsigned capacity = MIN(blocks * 64, 512u);
+    if (!c->active) {
+        return;
+    }
+    if (!capacity) {
+        c->active = false;
+        s->regs[RAW] |= 1u << (ch * 3 + 2);
+        update_irq(s);
+        return;
+    }
+    if (c->pending) {
+        c->pending = false;
+        c->position++;
+        unsigned limit = s->regs[0xd0 / 4 + ch] & 0x1ff;
+        if (limit && ++c->count >= limit) {
+            c->count = 0;
+            s->regs[RAW] |= 1u << (24 + ch);
+            update_irq(s);
+        }
+        if (c->position >= capacity) {
+            if (s->regs[0xf0 / 4] & 2) {
+                c->position = 0;
+            } else { c->end_pending = true; }
+        }
+    }
+    unsigned divider = s->regs[conf] & 255;
+    if (!divider) { divider = 256; }
+    uint64_t hz = s->regs[conf + 1] & (1u << 17) ? 80000000 : 1000000;
+    uint64_t ticks = 0;
+    unsigned limit = s->regs[0xd0 / 4 + ch] & 0x1ff;
+    /* Never batch across a CPU-visible refill or end boundary. */
+    for (;;) {
+        unsigned index = (ch * 64 + c->position) % 512;
+        /* In host-paced mode, don't replay an old half-buffer when host
+         * scheduling makes the guest refill late. Register-test mode retains
+         * strict hardware timing. The resulting LED pulse timing is approximate. */
+        if (s->refill_pacing && !c->end_pending && !s->fresh[index]) {
+            timer_mod(c->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100000);
+            return;
+        }
+        uint32_t word = s->ram[index];
+        s->fresh[index] = false;
+        unsigned d0 = word & 0x7fff, d1 = (word >> 16) & 0x7fff;
+        if (c->end_pending || !d0) {
+            emit(c, "end", word);
+            emit_pixels(c);
+            c->active = c->end_pending = false;
+            s->regs[conf + 1] &= ~1u;
+            s->regs[RAW] |= 1u << (ch * 3);
+            update_irq(s);
+            return;
+        }
+        emit(c, "symbol", word);
+        decode_pixel(c, word);
+        ticks += d0 + d1;
+        c->pending = true;
+        c->end_pending = !d1;
+        if (!d1 || (limit && c->count + 1 >= limit) ||
+            c->position + 1 >= capacity ||
+            (s->refill_pacing && !s->fresh[(ch * 64 + c->position + 1) % 512]) ||
+            !(s->ram[(ch * 64 + c->position + 1) % 512] & 0x7fff)) { break; }
+        c->position++;
+        if (limit) { c->count++; }
+    }
+    timer_mod(c->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+        (ticks * divider * 1000000000 + hz - 1) / hz);
+}
+static uint64_t read_reg(void *opaque, hwaddr addr, unsigned size)
+{
+    ArenaRmtState *s = opaque;
+    if (addr >= 0x800 && addr < 0x1000) { return s->ram[(addr - 0x800) / 4]; }
+    if (addr == 0xa4) { return s->regs[RAW] & s->regs[ENA]; }
+    if (addr == 0xac) { return 0; }
+    return addr < 0x100 ? s->regs[addr / 4] : 0;
+}
+static void write_reg(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    ArenaRmtState *s = opaque;
+    if (addr >= 0x800 && addr < 0x1000) { s->ram[(addr - 0x800) / 4] = value; s->fresh[(addr - 0x800) / 4] = true; return; }
+    if (addr == 0xac) { s->regs[RAW] &= ~value; update_irq(s); return; }
+    if (addr == 0xa0 || addr == 0xa4 || addr >= 0x100) { return; }
+    s->regs[addr / 4] = value;
+    if (addr == 0xa8) { update_irq(s); }
+    if (addr >= 0x24 && addr <= 0x5c && (addr & 7) == 4) {
+        ArenaRmtChannel *c = &s->channel[(addr - 0x24) / 8];
+        if (value & 8) { c->position = c->count = 0; c->pending = c->end_pending = false; }
+        if (value & 1) {
+            if (!c->active) {
+                c->active = true;
+                c->bits = 0; c->invalid = false;
+                memset(c->pixels, 0, sizeof(c->pixels));
+                emit(c, "start", 0);
+                timer_mod(c->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+            }
+        } else { c->active = false; timer_del(c->timer); }
+    }
+}
+static const MemoryRegionOps ops = {
+    .read = read_reg, .write = write_reg, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+static void reset(DeviceState *dev)
+{
+    ArenaRmtState *s = ARENA_RMT(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->ram, 0, sizeof(s->ram));
+    memset(s->fresh, 0, sizeof(s->fresh));
+    for (unsigned i = 0; i < 8; i++) {
+        s->channel[i].active = s->channel[i].pending = s->channel[i].end_pending = false;
+        s->channel[i].position = s->channel[i].count = 0;
+        timer_del(s->channel[i].timer);
+    }
+    update_irq(s);
+}
+static void init(Object *obj)
+{
+    ArenaRmtState *s = ARENA_RMT(obj);
+    memory_region_init_io(&s->iomem, obj, &ops, s, TYPE_ARENA_RMT, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    for (unsigned i = 0; i < 8; i++) {
+        s->channel[i].parent = s;
+        s->channel[i].index = i;
+        s->channel[i].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, step, &s->channel[i]);
+    }
+}
+static void finalize(Object *obj)
+{
+    ArenaRmtState *s = ARENA_RMT(obj);
+    for (unsigned i = 0; i < 8; i++) { timer_free(s->channel[i].timer); }
+}
+static Property properties[] = {
+    DEFINE_PROP_CHR("telemetry", ArenaRmtState, telemetry),
+    DEFINE_PROP_BOOL("trace-symbols", ArenaRmtState, trace_symbols, true),
+    DEFINE_PROP_BOOL("refill-pacing", ArenaRmtState, refill_pacing, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+static void class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, reset);
+    device_class_set_props(dc, properties);
+}
+static const TypeInfo info = {
+    .name = TYPE_ARENA_RMT, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ArenaRmtState), .instance_init = init,
+    .instance_finalize = finalize, .class_init = class_init,
+};
+static void register_types(void) { type_register_static(&info); }
+type_init(register_types)
diff --git a/hw/misc/esp32_wifi.c b/hw/misc/esp32_wifi.c
new file mode 100644
index 0000000..5b8f3ae
--- /dev/null
+++ b/hw/misc/esp32_wifi.c
@@ -0,0 +1,307 @@
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/error-report.h"
+#include "qemu/guest-random.h"
+#include "qapi/error.h"
+#include "sysemu/sysemu.h"
+#include "hw/hw.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32_wifi.h"
+#include "exec/address-spaces.h"
+#include "esp32_wlan_packet.h"
+#include "hw/qdev-properties.h"
+
+#define DEBUG(x)
+
+static uint64_t esp32_wifi_read(void *opaque, hwaddr addr, unsigned int size)
+{
+
+    Esp32WifiState *s = ESP32_WIFI(opaque);
+    uint32_t r = s->mem[addr/4];
+
+    switch(addr) {
+        case A_WIFI_DMA_IN_STATUS:
+            r=0;
+            break;
+        case A_WIFI_DMA_INT_STATUS_S3:
+        case A_WIFI_DMA_INT_CLR_S3:
+        case A_WIFI_DMA_INT_STATUS:
+        case A_WIFI_DMA_INT_CLR:
+
+            r=s->raw_interrupt;
+            break;
+        case A_WIFI_STATUS:
+        case A_WIFI_STATUS_S3:
+        case A_WIFI_DMA_OUT_STATUS:
+        case A_WIFI_DMA_OUT_STATUS_S3:
+            r=1;
+            break;
+    }
+
+    DEBUG(printf("esp32_wifi_read %lx=%x\n",addr,r);)
+
+    return r;
+}
+static void set_interrupt(Esp32WifiState *s,int e) {
+    s->raw_interrupt |= e;
+    qemu_set_irq(s->irq, 1);
+}
+
+static void esp32_wifi_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned int size) {
+    Esp32WifiState *s = ESP32_WIFI(opaque);
+    DEBUG(printf("esp32_wifi_write %lx=%lx\n",addr, value);)
+    if (s->trace_mmio && s->trace_count++ < 10000) {
+        qemu_log("wifi write offset=0x%03" HWADDR_PRIx " value=0x%08" PRIx64 "\n", addr, value);
+    }
+
+    if(s->iss3) {
+	switch (addr) {
+        case A_WIFI_DMA_INLINK_S3:
+            s->dma_inlink_address = value;
+            break;
+        case A_WIFI_DMA_INT_CLR_S3:
+            s->raw_interrupt &= ~value;
+            if(s->raw_interrupt==0)
+                qemu_set_irq(s->irq, 0);
+            break;
+        case A_WIFI_DMA_OUTLINK_S3:
+            if (value & 0xc0000000) {
+                // do a DMA transfer to the hardware from esp32 memory
+                mac80211_frame frame = {0};
+                dma_list_item item;
+                unsigned memaddr = (0x3fc00000 | (value & 0xfffff));
+                address_space_read(&address_space_memory, memaddr,
+                            MEMTXATTRS_UNSPECIFIED, &item, 12);
+                if (item.length < 24 || item.length > offsetof(mac80211_frame, frame_length)) { break; }
+                address_space_read(&address_space_memory, item.address,
+                            MEMTXATTRS_UNSPECIFIED, &frame, item.length);
+                DEBUG(printf("esp32_wifi_outlink %x %x %x\n",memaddr,item.length,*(uint32_t *)(s->macaddr)));
+                // frame from esp32 to ap
+                frame.frame_length=item.length;
+                frame.next_frame=0;
+                Esp32_WLAN_handle_frame(s, &frame);
+                set_interrupt(s,0x80);
+            }
+    }
+
+    } else {
+    switch (addr) {
+        case A_WIFI_DMA_IN_STATUS:
+            if ((value & 1) && !s->dma_inlink_address && s->rx_tail) {
+                dma_list_item tail;
+                if(address_space_read(&address_space_memory,s->rx_tail,MEMTXATTRS_UNSPECIFIED,&tail,12)==MEMTX_OK){
+                    s->dma_inlink_address=tail.next;
+                }
+            }
+            break;
+        case A_WIFI_DMA_INLINK:
+            s->rx_tail=0;
+            s->dma_inlink_address = value;
+            break;
+        case A_WIFI_DMA_INT_CLR:
+            s->raw_interrupt &= ~value;
+            if(s->raw_interrupt==0)
+                qemu_set_irq(s->irq, 0);
+            break;
+        case A_WIFI_DMA_OUTLINK:
+            if (value & 0xc0000000) {
+                // do a DMA transfer to the hardware from esp32 memory
+                mac80211_frame frame = {0};
+                dma_list_item item;
+                unsigned memaddr = (0x3ff00000 | (value & 0xfffff));
+                address_space_read(&address_space_memory, memaddr,
+                            MEMTXATTRS_UNSPECIFIED, &item, 12);
+                if (item.length < 24 || item.length > offsetof(mac80211_frame, frame_length)) { break; }
+                address_space_read(&address_space_memory, item.address,
+                            MEMTXATTRS_UNSPECIFIED, &frame, item.length);
+                // frame from esp32 to ap
+                frame.frame_length=item.length;
+                frame.next_frame=0;
+                Esp32_WLAN_handle_frame(s, &frame);
+                set_interrupt(s,0x80);
+            }
+    }
+    }
+    s->mem[addr/4]=value;
+}
+
+static int match_mac_address(uint8_t *a1,uint8_t *a2) {
+    if(!memcmp(a1,a2,6)) return 1;
+    if(!memcmp(a1,BROADCAST,6)) return 1;
+    return 0;
+}
+// frame from ap to esp32
+void Esp32_sendFrame(Esp32WifiState *s, mac80211_frame *frame,int length, int signal_strength) {
+    if (length < 24 || length > offsetof(mac80211_frame, frame_length)) { return; }
+    if (s->trace_mmio && s->trace_count++ < 10000) {
+        qemu_log("wifi RX type=%u subtype=%u bytes=%d descriptor=0x%08x\n",
+                 frame->frame_control.type, frame->frame_control.sub_type,
+                 length, s->dma_inlink_address);
+    }
+    if(s->dma_inlink_address==0) return;
+    uint8_t *bssid = frame->bssid_address;
+    if (frame->frame_control.type == IEEE80211_TYPE_DATA) {
+        if ((frame->frame_control.flags & 3) == 1) { bssid = frame->destination_address; }
+        if ((frame->frame_control.flags & 3) == 2) { bssid = frame->source_address; }
+    }
+    uint8_t *header;
+    if(!s->iss3) {
+    	header=malloc(sizeof(wifi_pkt_rx_ctrl_t)+length);
+    	wifi_pkt_rx_ctrl_t *pkt=(wifi_pkt_rx_ctrl_t *)header;
+    	*pkt=(wifi_pkt_rx_ctrl_t){
+    	    .rssi=(signal_strength+(rand()%10)+96),
+    	    .rate=11,
+	     	.sig_len=length,
+   	     	.sig_len_copy=length,
+        	.legacy_length=length,
+        	.noise_floor=-97,
+        	.channel=esp32_wifi_channel,
+        	.timestamp=qemu_clock_get_ns(QEMU_CLOCK_REALTIME)/1000,
+    	};
+        // These 4 bits are set if the mac addresses previously stored at 0x40 and 0x48
+    	// match the destination or bssid addresses in the frame
+    	if(match_mac_address(frame->destination_address,(uint8_t *)s->mem+0x40))
+       		pkt->damatch0=1;
+    	if(match_mac_address(frame->destination_address,(uint8_t *)s->mem+0x48))
+        	pkt->damatch1=1;
+    	if(match_mac_address(bssid,(uint8_t *)s->mem+0x40))
+        	pkt->bssidmatch0=1;
+    	if(match_mac_address(bssid,(uint8_t *)s->mem+0x48))
+        	pkt->bssidmatch1=1;
+
+    	memcpy(header+sizeof(wifi_pkt_rx_ctrl_t),frame,length);
+	    length+=sizeof(wifi_pkt_rx_ctrl_t);
+    } else {
+    	header=malloc(sizeof(wifi_pkt_rx_ctrl_s3_t)+length);
+    	wifi_pkt_rx_ctrl_s3_t *pkt=(wifi_pkt_rx_ctrl_s3_t *)header;
+    	*pkt=(wifi_pkt_rx_ctrl_s3_t){
+    	    .rssi=(signal_strength+(rand()%10)+96),
+    	    .rate=11,
+	     	.sig_len=length,
+   	     	.sig_len_copy=length,
+        	.legacy_length=length,
+        	.noise_floor=-97,
+        	.channel=esp32_wifi_channel,
+        	.timestamp=qemu_clock_get_ns(QEMU_CLOCK_REALTIME)/1000,
+    	};
+        // These 4 bits are set if the mac addresses previously stored at 0x40 and 0x48
+    	// match the destination or bssid addresses in the frame
+    	if(match_mac_address(frame->destination_address,(uint8_t *)s->mem+0x40)) 
+       		pkt->damatch0=1;
+    	if(match_mac_address(frame->destination_address,(uint8_t *)s->mem+0x48)) 
+        	pkt->damatch1=1;
+    	if(match_mac_address(bssid,(uint8_t *)s->mem+0x40)) 
+        	pkt->bssidmatch0=1;
+    	if(match_mac_address(bssid,(uint8_t *)s->mem+0x48)) 
+        	pkt->bssidmatch1=1;
+
+    	memcpy(header+sizeof(wifi_pkt_rx_ctrl_s3_t),frame,length);
+	    length+=sizeof(wifi_pkt_rx_ctrl_s3_t);
+	}
+    // do a DMA transfer from the hardware to esp32 memory
+    dma_list_item item = {0};
+    if (address_space_read(&address_space_memory, s->dma_inlink_address, MEMTXATTRS_UNSPECIFIED, &item, 12) != MEMTX_OK ||
+        !item.owner || length > item.size) {
+        free(header);
+        return;
+    }
+    address_space_write(&address_space_memory, item.address, MEMTXATTRS_UNSPECIFIED, header, length);
+    item.length=length;
+    item.eof=1;
+    address_space_write(&address_space_memory, s->dma_inlink_address, MEMTXATTRS_UNSPECIFIED,&item,4);
+    s->rx_tail=s->dma_inlink_address;
+    s->dma_inlink_address=item.next;
+    if(s->iss3)
+    	set_interrupt(s,0x1004024);
+    else
+	    set_interrupt(s,0x1000024);
+    free(header);
+}
+
+static const MemoryRegionOps esp32_wifi_ops = {
+    .read =  esp32_wifi_read,
+    .write = esp32_wifi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void esp32_wifi_realize(DeviceState *dev, Error **errp)
+{
+    Esp32WifiState *s = ESP32_WIFI(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+    s->dma_inlink_address=0;
+    s->rx_tail=0;
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &esp32_wifi_ops, s,
+                          TYPE_ESP32_WIFI, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    memset(s->mem,0,sizeof(s->mem));
+    Esp32_WLAN_setup_ap(dev, s);
+}
+
+static Property esp32_wifi_properties[] = {
+    DEFINE_NIC_PROPERTIES(Esp32WifiState, conf),
+    DEFINE_PROP_BOOL("trace-mmio", Esp32WifiState, trace_mmio, false),
+    DEFINE_PROP_STRING("station-password", Esp32WifiState, station_password),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32_wifi_reset_enter(Object *obj, ResetType type)
+{
+    Esp32WifiState *s = ESP32_WIFI(obj);
+    memset(s->mem, 0, sizeof(s->mem));
+    s->raw_interrupt=0;
+    s->dma_inlink_address=0;
+    s->rx_tail=0;
+    s->ap_state=0;
+    s->virtual_ap=false;
+    s->ap_key_stage=0;
+    s->key_pending=false;
+    s->key_ready=false;
+    s->guest_wpa2=false;
+    s->station_pn=0;
+    s->dhcp_requested=false;
+    s->guest_ssid[0]=0;
+    memset(s->station_ptk,0,sizeof(s->station_ptk));
+    memset(s->key_replay,0,sizeof(s->key_replay));
+    while (s->inject_queue) {
+        mac80211_frame *frame=s->inject_queue;
+        s->inject_queue=frame->next_frame;
+        g_free(frame);
+    }
+    s->inject_queue_size=0;
+    s->inject_timer_running=0;
+    s->inject_sequence_number=0;
+    s->trace_count=0;
+    if (s->inject_timer) { timer_del(s->inject_timer); }
+    if (s->irq) { qemu_set_irq(s->irq,0); }
+}
+
+static void esp32_wifi_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettablePhases rp;
+    dc->realize = esp32_wifi_realize;
+    set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
+    dc->desc = "Esp32 WiFi";
+    device_class_set_props(dc, esp32_wifi_properties);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    resettable_class_set_parent_phases(rc, esp32_wifi_reset_enter, NULL, NULL,
+                                   &rp);
+}
+
+static const TypeInfo esp32_wifi_info = {
+    .name = TYPE_ESP32_WIFI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32WifiState),
+    .class_init    = esp32_wifi_class_init,
+};
+
+static void esp32_wifi_register_types(void)
+{
+    type_register_static(&esp32_wifi_info);
+}
+
+type_init(esp32_wifi_register_types)
diff --git a/hw/misc/esp32_wifi_ap.c b/hw/misc/esp32_wifi_ap.c
new file mode 100644
index 0000000..713584a
--- /dev/null
+++ b/hw/misc/esp32_wifi_ap.c
@@ -0,0 +1,694 @@
+/**
+ * QEMU WLAN access point emulation
+ *
+ * Copyright (c) 2008 Clemens Kolbitsch
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to deal
+ * in the Software without restriction, including without limitation the rights
+ * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+ * copies of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+ * THE SOFTWARE.
+ *
+ * Modifications:
+ *  2008-February-24  Clemens Kolbitsch :
+ *                                  New implementation based on ne2000.c
+ *  18/1/22 Martin Johnson : Modified for esp32 wifi emulation
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/guest-random.h"
+#include <gcrypt.h>
+#include "net/net.h"
+#include "qemu/timer.h"
+
+#include "hw/misc/esp32_wifi.h"
+#include "esp32_wlan.h"
+#include "esp32_wlan_packet.h"
+
+// Match the advertised 100 TU beacon interval.
+#define BEACON_TIME 102400000
+#define INTER_FRAME_TIME 5000000
+#define DEBUG 0
+#define DEBUG_DUMPFRAMES 0
+
+access_point_info access_points[]={
+    {ARENA_WIFI_SSID,6,-30,{0x02,0x87,0x57,0x00,0x00,0x01},true}
+};
+
+int nb_aps=sizeof(access_points)/sizeof(access_point_info);
+
+static void Esp32_WLAN_beacon_timer(void *opaque)
+{
+    struct mac80211_frame *frame;
+    Esp32WifiState *s = (Esp32WifiState *)opaque;
+
+    // only send a beacon if we are an access point on the same channel
+    if(s->ap_state!=Esp32_WLAN__STATE_STA_ASSOCIATED) {
+        if (access_points[s->beacon_ap].channel==esp32_wifi_channel) {
+            frame = Esp32_WLAN_create_beacon_frame(&access_points[s->beacon_ap]);
+            Esp32_WLAN_init_ap_frame(s, frame);
+            memcpy(frame->source_address, access_points[s->beacon_ap].mac_address, 6);
+            memcpy(frame->bssid_address, access_points[s->beacon_ap].mac_address, 6);
+            Esp32_WLAN_insert_frame(s, frame);
+        }
+        s->beacon_ap=(s->beacon_ap+1)%nb_aps;
+    }
+    timer_mod(s->beacon_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + BEACON_TIME);
+}
+
+static void Esp32_WLAN_inject_timer(void *opaque)
+{
+    Esp32WifiState *s = (Esp32WifiState *)opaque;
+    struct mac80211_frame *frame;
+
+    frame = s->inject_queue;
+    if (frame) {
+        // remove from queue
+        s->inject_queue_size--;
+        s->inject_queue = frame->next_frame;
+        Esp32_sendFrame(s, (void *)frame, frame->frame_length,frame->signal_strength);
+        free(frame);
+    }
+    if (s->inject_queue_size > 0) {
+        // there are more packets... schedule
+        // the timer for sending them as well
+        timer_mod(s->inject_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INTER_FRAME_TIME);
+    } else {
+        // we wait until a new packet schedules
+        // us again
+        s->inject_timer_running = 0;
+    }
+
+}
+
+static void macprint(uint8_t *p, const char * name) {
+    printf("%s: %2x:%2x:%2x:%2x:%2x:%2x\n",name, p[0],p[1],p[2],p[3],p[4],p[5]);
+}
+
+static void infoprint(struct mac80211_frame *frame) {
+    if(DEBUG_DUMPFRAMES) {
+        printf("Frame Info %d %d %d %d %d\n",frame->frame_control.type,frame->frame_control.sub_type,frame->frame_control.flags,frame->duration_id, frame->frame_length);
+        macprint(frame->destination_address,"destination");
+        macprint(frame->source_address,"source");
+        macprint(frame->bssid_address,"bssid");
+        uint8_t *b=(uint8_t *)frame;
+        for(int i=0;i<frame->frame_length;i++) {
+            if((i%16)==0) printf("\n%04x: ",i);
+            printf("%02x ",b[i]);
+        }
+        printf("\n");
+    }
+}
+
+void Esp32_WLAN_insert_frame(Esp32WifiState *s, struct mac80211_frame *frame)
+{
+    struct mac80211_frame *i_frame;
+
+    /* RX DMA sees the hardware-decrypted CCMP layout. This models that
+     * boundary, not an encrypted over-the-air radio channel. */
+    if (s->key_ready && frame->frame_control.type == IEEE80211_TYPE_DATA &&
+        frame->frame_length >= 32 && !(frame->frame_control.flags & 0x40) &&
+        !(frame->data_and_fcs[6] == 0x88 && frame->data_and_fcs[7] == 0x8e)) {
+        size_t payload = frame->frame_length - 24;
+        if (payload + 20 > sizeof(frame->data_and_fcs)) { g_free(frame); return; }
+        memmove(frame->data_and_fcs+8,frame->data_and_fcs,payload);
+        uint64_t pn=++s->station_pn;
+        uint8_t *ccmp=frame->data_and_fcs;
+        ccmp[0]=pn; ccmp[1]=pn>>8; ccmp[2]=0; ccmp[3]=0x20;
+        for (int i=0;i<4;i++) { ccmp[4+i]=pn>>(16+8*i); }
+        memset(ccmp+8+payload,0,8);
+        frame->frame_length+=16;
+        frame->frame_control.flags|=0x40;
+    }
+
+    insertCRC(frame);
+    if(DEBUG) printf("Send Frame %d %d\n",frame->frame_control.type,frame->frame_control.sub_type);
+    infoprint(frame);
+    if (s->trace_mmio && frame->frame_control.type == IEEE80211_TYPE_DATA && s->trace_count++ < 10000) {
+        qemu_log("wifi data flags=%02x prefix=", frame->frame_control.flags);
+        for (int i=0; i<24 && i+24<frame->frame_length; i++) { qemu_log("%02x",frame->data_and_fcs[i]); }
+        qemu_log("\n");
+    }
+    s->inject_queue_size++;
+    i_frame = s->inject_queue;
+    if (!i_frame) {
+        s->inject_queue = frame;
+    } else {
+        while (i_frame->next_frame) {
+            i_frame = i_frame->next_frame;
+        }
+        i_frame->next_frame = frame;
+    }
+
+    if (!s->inject_timer_running) {
+        // if the injection timer is not
+        // running currently, let's schedule
+        // one run...
+        s->inject_timer_running = 1;
+        timer_mod(s->inject_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INTER_FRAME_TIME);
+    }
+
+}
+
+static _Bool Esp32_WLAN_can_receive(NetClientState *ncs)
+{
+    Esp32WifiState *s = qemu_get_nic_opaque(ncs);
+
+    if (s->ap_state != Esp32_WLAN__STATE_ASSOCIATED  && s->ap_state != Esp32_WLAN__STATE_STA_ASSOCIATED) {
+        // we are currently not connected
+        // to the access point
+        return 0;
+    }
+    if (s->inject_queue_size > Esp32_WLAN__MAX_INJECT_QUEUE_SIZE) {
+        // overload, please give me some time...
+        return 0;
+    }
+
+    return 1;
+}
+
+static ssize_t Esp32_WLAN_receive(NetClientState *ncs,
+                                    const uint8_t *buf, size_t size)
+{
+    Esp32WifiState *s = qemu_get_nic_opaque(ncs);
+    struct mac80211_frame *frame;
+    if (!Esp32_WLAN_can_receive(ncs)) {
+        // this should not happen, but in
+        // case it does, let's simply drop
+        // the packet
+        return -1;
+    }
+
+    if (!s) {
+        return -1;
+    }
+    /*
+     * A 802.3 packet comes from the qemu network. The
+     * access points turns it into a 802.11 frame and
+     * forwards it to the wireless device
+     */
+    if(s->trace_mmio && s->trace_count++<10000 && size>=42 && buf[12]==8 && buf[13]==0 && buf[14]==0x45 && buf[23]==17){
+        qemu_log("wifi upstream UDP %u.%u.%u.%u:%u -> %u.%u.%u.%u:%u bytes=%zu\n",
+            buf[26],buf[27],buf[28],buf[29],lduw_be_p(buf+34),
+            buf[30],buf[31],buf[32],buf[33],lduw_be_p(buf+36),size);
+    }
+    frame = Esp32_WLAN_create_data_packet(s, buf, size);
+    if (frame) {
+        memcpy(s->ap_macaddr,s->associated_ap_macaddr,6);
+        if(s->ap_state==Esp32_WLAN__STATE_STA_ASSOCIATED) {
+            frame->frame_control.flags=1;
+            // if it's an arp request put the correct reply mac address in the packet 
+            if( frame->data_and_fcs[6]==8 && frame->data_and_fcs[7]==6) {
+               if (frame->frame_length < 60) { g_free(frame); return size; }
+               memcpy(frame->data_and_fcs+16,s->macaddr,6);
+            }
+        }
+        Esp32_WLAN_init_ap_frame(s, frame);
+        if (s->virtual_ap) {
+            memcpy(frame->destination_address,s->peer_mac,6);
+            memcpy(frame->source_address,s->associated_ap_macaddr,6);
+            memcpy(frame->bssid_address,buf+6,6);
+        }
+        Esp32_WLAN_insert_frame(s, frame);
+    }
+    return size;
+}
+static void Esp32_WLAN_cleanup(NetClientState *ncs) { }
+
+static NetClientInfo net_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .can_receive = Esp32_WLAN_can_receive,
+    .receive = Esp32_WLAN_receive,
+    .cleanup = Esp32_WLAN_cleanup,
+};
