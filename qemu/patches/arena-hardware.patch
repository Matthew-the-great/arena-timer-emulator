     esp32_spi_txrx_buffer(s, &t->addr, t->addr_bytes, 0);
+    /* m25p80 represents QIO dummy clocks as SSI bytes. The ESP32 address
+     * phase already includes the mode byte; clock the flash through its
+     * remaining wait phase before collecting payload. Extra controller
+     * sampling delay is not additional data transferred by the flash. */
+    if (FIELD_EX32(s->user_reg, SPI_USER, DUMMY) && t->data_rx_bytes) {
+        unsigned dummy = 0;
+        switch (t->cmd & 0xff) {
+        case 0xeb: case 0xec: dummy = 4; break;
+        case 0x0b: case 0x0c: case 0x3b: case 0x6b: case 0x5a: dummy = 1; break;
+        default: break;
+        }
+        for (unsigned i = 0; i < dummy; i++) { ssi_transfer(s->spi, 0); }
+    }
     esp32_spi_txrx_buffer(s, t->data, t->data_tx_bytes, t->data_rx_bytes);
     esp32_spi_cs_set(s, 1);
 }
