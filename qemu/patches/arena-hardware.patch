+void Esp32_WLAN_setup_ap(DeviceState *dev,Esp32WifiState *s) {
+
+    s->ap_state = Esp32_WLAN__STATE_NOT_AUTHENTICATED;
+    s->beacon_ap=0;
+    memcpy(s->ap_macaddr,(uint8_t[]){0x01,0x13,0x46,0xbf,0x31,0x50},sizeof(s->ap_macaddr));
+    memcpy(s->macaddr,(uint8_t[]){0x10,0x01,0x00,0xc4,0x0a,0x24},sizeof(s->macaddr));
+
+    s->inject_timer_running = 0;
+    s->inject_sequence_number = 0;
+
+    s->inject_queue = NULL;
+    s->inject_queue_size = 0;
+
+    s->beacon_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, Esp32_WLAN_beacon_timer, s);
+    timer_mod(s->beacon_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)+100000000);
+
+    // setup the timer but only schedule
+    // it when necessary...
+    s->inject_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, Esp32_WLAN_inject_timer, s);
+
+    s->nic = qemu_new_nic(&net_info, &s->conf, object_get_typename(OBJECT(s)), dev->id, &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->macaddr);
+}
+
+static void send_single_frame(Esp32WifiState *s, struct mac80211_frame *frame, struct mac80211_frame *reply) {
+    reply->sequence_control.sequence_number = s->inject_sequence_number++ +0x730;
+    reply->signal_strength=-10;
+
+    if(frame) {
+        memcpy(reply->destination_address, frame->source_address, 6);
+        memcpy(reply->source_address, s->macaddr, 6);
+        memcpy(reply->bssid_address, frame->source_address, 6);
+    }
+    
+    Esp32_WLAN_insert_frame(s, reply);
+}
+static bool station_hmac(const uint8_t *key, size_t keylen,
+                         const uint8_t *data, size_t len, uint8_t out[20])
+{
+    gcry_md_hd_t md;
+    if (gcry_md_open(&md, GCRY_MD_SHA1, GCRY_MD_FLAG_HMAC)) { return false; }
+    if (gcry_md_setkey(md, key, keylen)) { gcry_md_close(md); return false; }
+    gcry_md_write(md, data, len);
+    memcpy(out, gcry_md_read(md, GCRY_MD_SHA1), 20);
+    gcry_md_close(md);
+    return true;
+}
+
+/* WPA2 authenticator for the single virtual router. Frames cross the same
+ * hardware-decrypted DMA boundary as the existing station implementation. */
+static void router_key(Esp32WifiState *s, bool message3)
+{
+    static const uint8_t rsn[]={48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+    mac80211_frame *f=g_new0(mac80211_frame,1);
+    f->frame_control.type=IEEE80211_TYPE_DATA; f->frame_control.flags=2;
+    memcpy(f->destination_address,s->peer_mac,6);
+    memcpy(f->source_address,access_points[0].mac_address,6);
+    memcpy(f->bssid_address,access_points[0].mac_address,6);
+    memcpy(f->data_and_fcs,(uint8_t[]){0xaa,0xaa,3,0,0,0,0x88,0x8e},8);
+    uint8_t *key=f->data_and_fcs+8;
+    size_t len=99;
+    key[0]=2;key[1]=3;key[4]=2;
+    stw_be_p(key+5,message3?0x13ca:0x008a);stw_be_p(key+7,16);
+    key[16]=message3?2:1;
+    memcpy(key+17,s->ap_nonce,32);
+    if(message3){
+        uint8_t data[48]={0};memcpy(data,rsn,sizeof(rsn));
+        memcpy(data+22,(uint8_t[]){0xdd,22,0,15,172,1,1,0},8);
+        memcpy(data+30,s->gtk,16);data[46]=0xdd;
+        gcry_cipher_hd_t wrap;
+        if(gcry_cipher_open(&wrap,GCRY_CIPHER_AES128,GCRY_CIPHER_MODE_AESWRAP,0)){g_free(f);return;}
+        gcry_error_t err=gcry_cipher_setkey(wrap,s->station_ptk+16,16);
+        if(!err)err=gcry_cipher_encrypt(wrap,key+99,56,data,48);
+        gcry_cipher_close(wrap);if(err){g_free(f);return;}
+        len+=56;stw_be_p(key+97,56);
+    }
+    stw_be_p(key+2,len-4);
+    if(message3){uint8_t mic[20];if(!station_hmac(s->station_ptk,16,key,len,mic)){g_free(f);return;}memcpy(key+81,mic,16);}
+    f->frame_length=24+8+len;send_single_frame(s,NULL,f);
+    qemu_log("wifi virtual router sent message %u\n",message3?3:1);
+}
+static void router_eapol(Esp32WifiState *s,mac80211_frame *f)
+{
+    if(!s->virtual_ap || !s->ap_key_stage || f->frame_length<131 ||
+       memcmp(f->source_address,s->peer_mac,6)){return;}
+    const uint8_t *key=f->data_and_fcs+8;
+    size_t len=4+lduw_be_p(key+2);
+    if(len<99 || len>2048 || len>f->frame_length-32 || key[1]!=3 || key[4]!=2 ||
+       lduw_be_p(key+97)!=len-99){return;}
+    unsigned info=lduw_be_p(key+5);
+    if(info!=0x010a && info!=0x030a){return;}
+    uint8_t replay[8]={0};replay[7]=info==0x010a?1:2;
+    if(memcmp(key+9,replay,8)){return;}
+    if(info==0x010a){
+        uint8_t pmk[32],input[100],digest[20];
+        if(gcry_kdf_derive(ARENA_WIFI_PASSWORD,strlen(ARENA_WIFI_PASSWORD),GCRY_KDF_PBKDF2,
+            GCRY_MD_SHA1,ARENA_WIFI_SSID,strlen(ARENA_WIFI_SSID),4096,32,pmk)){return;}
+        const uint8_t *a=access_points[0].mac_address,*b=s->peer_mac;
+        if(memcmp(a,b,6)>0){const uint8_t *t=a;a=b;b=t;}
+        memcpy(input,"Pairwise key expansion",23);memcpy(input+23,a,6);memcpy(input+29,b,6);
+        a=s->ap_nonce;b=key+17;
+        if(memcmp(a,b,32)>0){const uint8_t *t=a;a=b;b=t;}
+        memcpy(input+35,a,32);memcpy(input+67,b,32);
+        for(int i=0;i<4;i++){input[99]=i;if(!station_hmac(pmk,32,input,100,digest)){return;}
+            memcpy(s->station_ptk+i*20,digest,MIN(20,64-i*20));}
+    }else if(s->ap_key_stage!=3){return;}
+    uint8_t copy[2048],mic[20];memcpy(copy,key,len);memset(copy+81,0,16);
+    if(!station_hmac(s->station_ptk,16,copy,len,mic)){return;}
+    unsigned mismatch=0;for(int i=0;i<16;i++)mismatch|=mic[i]^key[81+i];
+    if(mismatch){qemu_log("wifi virtual router rejected key MIC (wrong password or corrupt frame)\n");return;}
+    if(info==0x010a){s->ap_key_stage=3;router_key(s,true);}
+    else{s->ap_key_stage=4;s->key_ready=true;s->ap_state=Esp32_WLAN__STATE_ASSOCIATED;
+        qemu_log("wifi virtual router WPA2 authenticated guest\n");}
+}
+
+static void station_eapol(Esp32WifiState *s, mac80211_frame *frame)
+{
+    static const uint8_t rsn[] = {48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+    if (!s->guest_wpa2 || !s->station_password || frame->frame_length < 24+8+99) { return; }
+    const uint8_t *key = frame->data_and_fcs + 8;
+    size_t len = 4 + lduw_be_p(key + 2);
+    if (len < 99 || len > frame->frame_length - 32 || len > 2048 ||
+        key[1] != 3 || key[4] != 2 || lduw_be_p(key+97) != len-99) { return; }
+    uint16_t info = lduw_be_p(key+5);
+    bool message1 = info == 0x008a;
+    bool message3 = (info & 0x3fff) == 0x13ca;
+    if (!message1 && !message3) { return; }
+    if (message1) {
+        if (s->key_ready) { return; } /* Rekeying is not implemented. */
+        size_t passlen = strlen(s->station_password);
+        if (passlen < 8 || passlen > 63) { return; }
+        if (!s->key_pending || memcmp(s->ap_nonce, key+17, 32)) {
+            uint8_t pmk[32], context[100], input[123], digest[20];
+            if (gcry_kdf_derive(s->station_password, passlen, GCRY_KDF_PBKDF2,
+                    GCRY_MD_SHA1, s->guest_ssid, strlen(s->guest_ssid), 4096, 32, pmk)) { return; }
+            qemu_guest_getrandom_nofail(s->station_nonce, 32);
+            memcpy(s->ap_nonce, key+17, 32);
+            memcpy(s->associated_ap_macaddr,frame->source_address,6);
+            const uint8_t *a = frame->source_address, *b = s->macaddr;
+            if (memcmp(a,b,6)>0) { const uint8_t *tmp=a; a=b; b=tmp; }
+            memcpy(context,a,6); memcpy(context+6,b,6);
+            a=s->ap_nonce; b=s->station_nonce;
+            if (memcmp(a,b,32)>0) { const uint8_t *tmp=a; a=b; b=tmp; }
+            memcpy(context+12,a,32); memcpy(context+44,b,32);
+            memcpy(input,"Pairwise key expansion",23); /* includes NUL */
+            memcpy(input+23,context,76);
+            for (int i=0;i<4;i++) {
+                input[99]=i;
+                if (!station_hmac(pmk,32,input,100,digest)) { return; }
+                memcpy(s->station_ptk+i*20,digest,MIN(20,64-i*20));
+            }
+            s->key_pending=true;
+            s->key_ready=false;
+        }
+        memcpy(s->key_replay,key+9,8);
+    } else {
+        if (!s->key_pending || memcmp(frame->source_address,s->associated_ap_macaddr,6) ||
+            memcmp(s->ap_nonce,key+17,32) ||
+            memcmp(key+9,s->key_replay,8)<0) { return; }
+        uint8_t copy[2048], mic[20];
+        memcpy(copy,key,len); memset(copy+81,0,16);
+        if (!station_hmac(s->station_ptk,16,copy,len,mic)) { return; }
+        unsigned mismatch=0;
+        for (int i=0;i<16;i++) { mismatch |= mic[i]^key[81+i]; }
+        if (mismatch) { qemu_log("wifi WPA2 message 3 MIC rejected\n"); return; }
+        /* Authenticate wrapped key data too; do not acknowledge corrupt GTK. */
+        size_t wrapped_len=len-99;
+        if (wrapped_len < 16 || wrapped_len % 8) { return; }
+        gcry_cipher_hd_t wrap;
+        uint8_t key_data[2048];
+        if (gcry_cipher_open(&wrap,GCRY_CIPHER_AES128,GCRY_CIPHER_MODE_AESWRAP,0)) { return; }
+        gcry_error_t err=gcry_cipher_setkey(wrap,s->station_ptk+16,16);
+        if (!err) { err=gcry_cipher_decrypt(wrap,key_data,wrapped_len-8,key+99,wrapped_len); }
+        gcry_cipher_close(wrap);
+        if (err) { qemu_log("wifi WPA2 wrapped key data rejected\n"); return; }
+        memcpy(s->key_replay,key+9,8);
+    }
+    mac80211_frame *reply=g_new0(mac80211_frame,1);
+    reply->frame_control.type=IEEE80211_TYPE_DATA;
+    reply->frame_control.flags=1;
+    memcpy(reply->destination_address,frame->source_address,6);
+    memcpy(reply->source_address,s->macaddr,6);
+    memcpy(reply->bssid_address,frame->source_address,6);
+    memcpy(reply->data_and_fcs,(uint8_t[]){0xaa,0xaa,3,0,0,0,0x88,0x8e},8);
+    uint8_t *out=reply->data_and_fcs+8;
+    size_t outlen=99+(message1?sizeof(rsn):0);
+    out[0]=key[0]; out[1]=3; stw_be_p(out+2,outlen-4); out[4]=2;
+    stw_be_p(out+5,message1?0x010a:0x030a);
+    memcpy(out+9,key+9,8);
+    if (message1) { memcpy(out+17,s->station_nonce,32); memcpy(out+99,rsn,sizeof(rsn)); }
+    stw_be_p(out+97,outlen-99);
+    uint8_t mic[20];
+    if (!station_hmac(s->station_ptk,16,out,outlen,mic)) { g_free(reply); return; }
+    memcpy(out+81,mic,16);
+    reply->frame_length=24+8+outlen;
+    send_single_frame(s,NULL,reply);
+    qemu_log("wifi WPA2 sent message %u\n",message1?2:4);
+    if (message3 && !s->key_ready) {
+        s->key_ready=true;
+        memcpy(s->ap_macaddr,frame->source_address,6);
+        memcpy(s->associated_ap_macaddr,frame->source_address,6);
+        mac80211_frame *dhcp=Esp32_WLAN_create_dhcp_discover();
+        memcpy(dhcp->bssid_address,BROADCAST,6);
+        memcpy(dhcp->source_address,s->macaddr,6);
+        memcpy(dhcp->destination_address,frame->source_address,6);
+        send_single_frame(s,NULL,dhcp);
+        s->ap_state=Esp32_WLAN__STATE_STA_DHCP;
+    }
+}
+
+void Esp32_WLAN_handle_frame(Esp32WifiState *s, struct mac80211_frame *frame)
+{
+    struct mac80211_frame *reply = NULL;
+    if (s->trace_mmio && s->trace_count++ < 10000) {
+        qemu_log("wifi TX type=%u subtype=%u bytes=%u state=%u\n",
+                 frame->frame_control.type, frame->frame_control.sub_type,
+                 frame->frame_length, s->ap_state);
+    }
+    access_point_info dummy_ap = { .ssid = s->guest_ssid, .wpa2 = s->guest_wpa2 };
+    if (s->trace_mmio && frame->frame_control.type == IEEE80211_TYPE_DATA && s->trace_count++ < 10000) {
+        qemu_log("wifi guest data flags=%02x prefix=",frame->frame_control.flags);
+        for (int i=0;i<24 && i+24<frame->frame_length;i++) { qemu_log("%02x",frame->data_and_fcs[i]); }
+        qemu_log("\n");
+    }
+    if (s->key_ready && frame->frame_control.type == IEEE80211_TYPE_DATA &&
+        (frame->frame_control.flags & 0x40) && frame->frame_length >= 48 &&
+        frame->data_and_fcs[8] == 0xaa && frame->data_and_fcs[9] == 0xaa) {
+        /* TX descriptors carry plaintext with CCMP encapsulation space. */
+        memmove(frame->data_and_fcs,frame->data_and_fcs+8,frame->frame_length-24-16);
+        frame->frame_length-=16;
+        frame->frame_control.flags&=~0x40;
+    }
+    unsigned long ethernet_frame_size;
+    unsigned char ethernet_frame[1518];
+    if(DEBUG) 
+        printf("-------------------------\nHandle Frame %d %d %d %d\n",frame->frame_control.type,frame->frame_control.sub_type,esp32_wifi_channel,s->ap_state);
+    infoprint(frame);
+    access_point_info *ap_info=0;
+    for(int i=0;i<nb_aps;i++)
+        if(access_points[i].channel==esp32_wifi_channel)
+            ap_info=&access_points[i];
+   
+    if(frame->frame_control.type == IEEE80211_TYPE_MGT) {        
+        switch(frame->frame_control.sub_type) {
+            case IEEE80211_TYPE_MGT_SUBTYPE_BEACON:
+                /* A beacon transmitted by the guest means it has entered AP
+                 * mode (e.g. after a failed router login). Resume setup access. */
+                if (s->virtual_ap) {
+                    s->virtual_ap=false;s->ap_key_stage=0;
+                    s->key_ready=s->key_pending=s->dhcp_requested=false;
+                    s->station_pn=0;s->ap_state=Esp32_WLAN__STATE_NOT_AUTHENTICATED;
+                }
+                if(s->ap_state==Esp32_WLAN__STATE_NOT_AUTHENTICATED || s->ap_state==Esp32_WLAN__STATE_AUTHENTICATED) {
+                    if (frame->frame_length < 38 || frame->data_and_fcs[12] != 0 ||
+                        frame->data_and_fcs[13] > 32 ||
+                        38 + frame->data_and_fcs[13] > frame->frame_length) { break; }
+                    memcpy(s->guest_ssid, frame->data_and_fcs + 14, frame->data_and_fcs[13]);
+                    s->guest_ssid[frame->data_and_fcs[13]] = '\0';
+                    s->ap_state=Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED;
+                    send_single_frame(s,frame,Esp32_WLAN_create_probe_request(&dummy_ap));
+                }
+                break;
+            case IEEE80211_TYPE_MGT_SUBTYPE_PROBE_RESP:
+                ap_info=&dummy_ap;
+                if (frame->frame_length < 38 || frame->data_and_fcs[12] != 0 ||
+                    frame->data_and_fcs[13] > 32 ||
+                    38 + frame->data_and_fcs[13] > frame->frame_length) { break; }
+                memcpy(s->guest_ssid, frame->data_and_fcs + 14, frame->data_and_fcs[13]);
+                s->guest_ssid[frame->data_and_fcs[13]] = '\0';
+                s->guest_wpa2 = (frame->data_and_fcs[10] & 0x10) != 0;
+                dummy_ap.wpa2 = s->guest_wpa2;
+                s->ap_state=Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED;
+                send_single_frame(s,frame,Esp32_WLAN_create_deauthentication());
+                send_single_frame(s,frame,Esp32_WLAN_create_authentication_request());
+                break;
+            case IEEE80211_TYPE_MGT_SUBTYPE_ASSOCIATION_RESP:
+                if (frame->frame_length < 30) { break; }
+                unsigned status = lduw_le_p(frame->data_and_fcs + 2);
+                if (s->trace_mmio && s->trace_count++ < 10000) {
+                    qemu_log("wifi association response status=%u\n", status);
+                }
+                if (status != 0) {
+                    /* Rejection is not association: do not send DHCP. */
+                    s->ap_state = Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED;
+                    break;
+                }
+                if(DEBUG) printf("assoc resp\n");
+                if (s->guest_wpa2) {
+                    s->ap_state = Esp32_WLAN__STATE_STA_AUTHENTICATED;
+                    break; /* DHCP must wait for the WPA2 four-way handshake. */
+                }
+                mac80211_frame *frame1=Esp32_WLAN_create_dhcp_discover();
+                memcpy(frame1->bssid_address,BROADCAST,6);
+                memcpy(frame1->source_address,frame->destination_address,6);
+                memcpy(frame1->destination_address,frame->source_address,6);
+                send_single_frame(s,0,frame1);
+                s->ap_state=Esp32_WLAN__STATE_STA_DHCP;
+                break;
+            case IEEE80211_TYPE_MGT_SUBTYPE_DISASSOCIATION:
+                DEBUG_PRINT_AP(("Received disassociation!\n"));
+                send_single_frame(s,frame,Esp32_WLAN_create_disassociation());
+                if (s->ap_state == Esp32_WLAN__STATE_ASSOCIATED || s->ap_state == Esp32_WLAN__STATE_STA_ASSOCIATED) {
+                    s->ap_state = Esp32_WLAN__STATE_AUTHENTICATED;
+                }
+                break;
+            case IEEE80211_TYPE_MGT_SUBTYPE_DEAUTHENTICATION:
+                DEBUG_PRINT_AP(("Received deauthentication!\n"));
+                //reply = Esp32_WLAN_create_authentication_response(ap_info);
+                if (s->ap_state == Esp32_WLAN__STATE_AUTHENTICATED ||
+                    (!s->virtual_ap && s->ap_state >= Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED &&
+                     !memcmp(frame->source_address,s->associated_ap_macaddr,6))) {
+                    s->ap_state = Esp32_WLAN__STATE_NOT_AUTHENTICATED;
+                    s->key_ready=s->key_pending=s->dhcp_requested=false;
+                    s->station_pn=0;
+                }
+                break;
+            case IEEE80211_TYPE_MGT_SUBTYPE_AUTHENTICATION:
+                DEBUG_PRINT_AP(("Received authentication!\n"));
+                if(frame->data_and_fcs[2]==2) { // response
+                    send_single_frame(s,frame,Esp32_WLAN_create_association_request(&dummy_ap));
+                }
+                break;
+        }
+        if(ap_info) {
+            memcpy(s->ap_macaddr,ap_info->mac_address,6);
+            switch(frame->frame_control.sub_type) {
+                case IEEE80211_TYPE_MGT_SUBTYPE_PROBE_REQ:
+                    DEBUG_PRINT_AP(("Received probe request!\n"));
+                    reply = Esp32_WLAN_create_probe_response(ap_info);
+                    break;
+                case IEEE80211_TYPE_MGT_SUBTYPE_AUTHENTICATION:
+                    DEBUG_PRINT_AP(("Received authentication req %d!\n",s->ap_state));
+                    if(frame->frame_length >= 30 && frame->data_and_fcs[2]==1 &&
+                       !memcmp(frame->destination_address,ap_info->mac_address,6)) {
+                        s->virtual_ap=true;s->key_ready=false;s->ap_key_stage=0;
+                        memcpy(s->peer_mac,frame->source_address,6);
+                        s->ap_state=Esp32_WLAN__STATE_NOT_AUTHENTICATED;
+                        reply = Esp32_WLAN_create_authentication_response(ap_info);
+                        if (s->ap_state == Esp32_WLAN__STATE_NOT_AUTHENTICATED) {
+                            s->ap_state = Esp32_WLAN__STATE_AUTHENTICATED;
+                        }
+                    } 
+                break;
+                case IEEE80211_TYPE_MGT_SUBTYPE_ASSOCIATION_REQ:
+                    DEBUG_PRINT_AP(("Received association request!\n"));
+                    if(!s->virtual_ap || s->ap_state!=Esp32_WLAN__STATE_AUTHENTICATED ||
+                       memcmp(frame->source_address,s->peer_mac,6) || frame->frame_length<30){break;}
+                    reply = Esp32_WLAN_create_association_response(ap_info);
+                    memcpy(s->associated_ap_macaddr,s->ap_macaddr,6);
+                    qemu_guest_getrandom_nofail(s->ap_nonce,32);
+                    qemu_guest_getrandom_nofail(s->gtk,16);
+                    s->ap_key_stage=1;
+                    break;
+            }
+            if (reply) {
+                reply->signal_strength=ap_info->sigstrength;
+                memcpy(reply->destination_address, frame->source_address, 6);
+                Esp32_WLAN_init_ap_frame(s, reply);
+                Esp32_WLAN_insert_frame(s, reply);
+                if(s->virtual_ap && frame->frame_control.sub_type==IEEE80211_TYPE_MGT_SUBTYPE_ASSOCIATION_REQ && s->ap_key_stage==1){router_key(s,false);}
+            }
+        }
+    }
+    if ((frame->frame_control.type == IEEE80211_TYPE_DATA) &&
+        (frame->frame_control.sub_type == IEEE80211_TYPE_DATA_SUBTYPE_DATA)) {
+        if (frame->frame_length >= 36 && frame->data_and_fcs[6] == 0x88 && frame->data_and_fcs[7] == 0x8e) {
+            if (s->trace_mmio && s->trace_count++ < 10000) {
+                qemu_log("wifi EAPOL bytes=%u keyinfo=0x%04x\n", frame->frame_length,
+                         frame->frame_length >= 39 ? lduw_be_p(frame->data_and_fcs + 13) : 0);
+            }
+            if(s->virtual_ap)router_eapol(s,frame);else station_eapol(s, frame);
+            return;
+        }
+        if(s->ap_state == Esp32_WLAN__STATE_STA_DHCP) {
+            if (frame->frame_length < 24+8+sizeof(dhcp_request_t)+3+4 ||
+                frame->data_and_fcs[6] != 8 || frame->data_and_fcs[7] != 0 ||
+                frame->data_and_fcs[8] != 0x45 || frame->data_and_fcs[17] != 17) { return; }
+            dhcp_request_t *req=(dhcp_request_t *)&frame->data_and_fcs[8];
+            if (req->dhcp.opcode != 2 || req->dhcp.xid != 0x1d3d00 ||
+                req->dhcp.magic_cookie != 0x63538263) { return; }
+            unsigned message_type=0;
+            size_t available=frame->frame_length-24-8-sizeof(dhcp_request_t)-4;
+            for (size_t pos=0;pos<available;) {
+                const uint8_t *options=req->dhcp.bp_options;
+                unsigned tag=options[pos++];
+                if (tag==255) { break; }
+                if (tag==0) { continue; }
+                if (pos>=available) { return; }
+                unsigned size=options[pos++];
+                if (size>available-pos) { return; }
+                if (tag==53 && size==1) { message_type=options[pos]; }
+                pos+=size;
+            }
+            if (message_type==5 && s->dhcp_requested) {
+                memcpy(s->ipaddr,req->dhcp.yiaddr,4);
+                s->ap_state=Esp32_WLAN__STATE_STA_ASSOCIATED;
+                qemu_log("wifi DHCP ACK accepted\n");
+            }
+            if(message_type==2 && !s->dhcp_requested) {
+                mac80211_frame *frame1=Esp32_WLAN_create_dhcp_request(req->dhcp.yiaddr);
+                memcpy(frame1->bssid_address,BROADCAST,6);
+                memcpy(frame1->source_address,s->macaddr,6);
+                memcpy(frame1->destination_address,frame->source_address,6);
+                send_single_frame(s,0,frame1);
+                memcpy(s->ap_macaddr,frame->source_address,6);
+                memcpy(s->associated_ap_macaddr,frame->source_address,6);
+                s->dhcp_requested=true;
+            }
+        } else if (s->ap_state == Esp32_WLAN__STATE_ASSOCIATED || s->ap_state == Esp32_WLAN__STATE_STA_ASSOCIATED) {
+            /*
+            * The access point uses the 802.11 frame
+            * and sends a 802.3 frame into the network...
+            * This packet is then understandable by
+            * qemu-slirp
+            *
+            * If we ever want the access point to offer
+            * some services, it can be added here!!
+            */
+            // ethernet header type
+            ethernet_frame[12] = frame->data_and_fcs[6];
+            ethernet_frame[13] = frame->data_and_fcs[7];
+
+            // the new originator of the packet is
+            // the access point
+            memcpy(&ethernet_frame[6], frame->source_address, 6);
+
+            if (ethernet_frame[12] == 0x08 && ethernet_frame[13] == 0x06) {
+                // for arp request, we use a broadcast
+                memset(&ethernet_frame[0], 0xff, 6);
+            } else {
+                // otherwise we forward the packet to
+                // where it really belongs
+                memcpy(&ethernet_frame[0], s->virtual_ap ? frame->bssid_address : frame->destination_address, 6);
+            }
+
+            // add packet content
+            ethernet_frame_size = frame->frame_length - 24 - 4 - 8;
+
+            if (frame->frame_length < 36 || ethernet_frame_size > sizeof(ethernet_frame)-14) { return; }
+            /* DMA padding/FCS must never become IP payload. */
+            if (ethernet_frame[12] == 8 && ethernet_frame[13] == 0 && ethernet_frame_size >= 20) {
+                size_t iplen=lduw_be_p(frame->data_and_fcs+10);
+                if (iplen < 20 || iplen > ethernet_frame_size) { return; }
+                ethernet_frame_size=iplen;
+            }
+            memcpy(&ethernet_frame[14], &frame->data_and_fcs[8], ethernet_frame_size);
+            // add size of ethernet header
+            ethernet_frame_size += 14;
+            /*
+            * Send 802.3 frame
+            */
+            qemu_send_packet(qemu_get_queue(s->nic), ethernet_frame, ethernet_frame_size);
+        }
+    }
+}
+
